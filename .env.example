# ============================================================================
# PLAN REVIEW AI HYBRID - VARIABLES DE ENTORNO DE DESARROLLO & PRODUCCIÓN
# ============================================================================

# Entorno y Depuración
ENVIRONMENT=development
DEBUG=true

# ----------------------------------------------------------------------------
# Base de Datos PostgreSQL 15+ & Row-Level Security (RLS)
# ----------------------------------------------------------------------------
# 1. Rol de Aplicación (Runtime - NOBYPASSRLS / NOSUPERUSER)
DATABASE_URL=postgresql+psycopg://app_user:app_user_dev_pass@localhost:5432/planreview
DB_ECHO=false

# 2. Rol Migrador / Propietario de Esquema (Exclusivo para migraciones y RLS DDL)
POSTGRES_MIGRATOR_URL=postgresql+psycopg://postgres_migrator:migrator_secure_pass_123@localhost:5432/planreview

# 3. Base de Datos de Integración para Test de RLS
POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://app_user:app_user_dev_pass@localhost:5433/planreview_test

# ----------------------------------------------------------------------------
# Redis & Workers Asíncronos
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Seguridad, JWT & Criptografía
# ----------------------------------------------------------------------------
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ----------------------------------------------------------------------------
# Configuración de Inferencia y Visión
# ----------------------------------------------------------------------------
DEFAULT_RENDER_DPI=300
UNCERTAINTY_MIN_CONF=0.35
UNCERTAINTY_MAX_CONF=0.70
